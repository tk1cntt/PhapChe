DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_service_dev?schema=public"

# === BETTER AUTH ===
BETTER_AUTH_SECRET="replace-with-random-64-char-hex"
BETTER_AUTH_URL="http://localhost:3000"

# === DATABASE MIGRATION PHASE FLAGS ===
# Phase 2: Add new FK columns (backward compatible)
DB_MIGRATION_PHASE2=false

# Phase 3: Data backfill (run migration scripts)
DB_MIGRATION_PHASE3=false

# Phase 4: BREAKING CHANGES - Drop old columns
# Set to 'true' ONLY after all services updated and tested
DB_MIGRATION_PHASE4=false

# === AI / LLM ===
# Chọn MỘT trong các provider dưới đây:
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"  # hoặc custom endpoint
# ANTHROPIC_API_KEY="sk-ant-..."
# GROQ_API_KEY="gsk_..."
# LLM_GATEWAY_KEY="..."  # key cho custom gateway
# LLM_GATEWAY_URL="..."  # URL gateway (VD: LiteLLM, OpenRouter)

# Model mặc định (để trống → gpt-4o-mini)
AI_DEFAULT_MODEL="gpt-4o-mini"
